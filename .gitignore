# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── Claude Code configuration (local-only — never push to git) ──────────
CLAUDE.md
**/CLAUDE.md
.claude/
.claudeignore

# Music library — the masters live here locally but are HOSTED ON THE BACKEND
# (public/music/ on the Laravel box, served via GET /api/music). Shipping ~39MB
# of MP3 in the Vercel deploy would re-upload them on every build for files that
# never change. Regenerate the upload payload with `npm run music`.
/public/audio/
/.music-dist/
